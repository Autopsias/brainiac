      "id": "AG-01",
      "family": "dossier_routing_tensions",
      "dimension": "S",
      "prompt": "What have we decided on the Contoso API gateway architecture?",
      "gold_ids": ["dec-contoso-api-gateway", "raw-2026-10-12-gateway-proposal"],
      "expectations": {
        "required_tools": ["dossier"],
        "forbidden_tools": ["web_search"],
        "min_tool_families": 1,
        "require_get_confirmation": false,
        "must_mention_all": ["dec-contoso-api-gateway", "managed edge gateway", "tension"],
        "must_mention_any": ["raw-2026-10-12-gateway-proposal", "newer source"],
        "must_match_all": [
          "(?:current|active)\\s+decision.{0,40}dec-contoso-api-gateway|dec-contoso-api-gateway.{0,40}(?:current|active|remains|stands)",
          "(?:without\\s+promoting|not\\s+(?:promoted|approved|decided|superseded)|unresolved\\s+tension|does\\s+not\\s+overturn)"
        ],
        "must_not_mention": [
          "dec-contoso-api-gateway-v1 is current",
          "proposal overturns the decision",
          "switched to mesh gateway"
        ],
        "must_not_match": [
          "dec-contoso-api-gateway-v1\\b",
          "\\b(?:switched|migrated|moved|adopted|approved)\\b.{0,35}\\b(?:mesh|proposal|gateway-proposal)\\b",
          "\\b(?:mesh(?:\\s+gateway)?|proposal|gateway-proposal)\\b.{0,35}\\b(?:is\\s+(?:now\\s+)?(?:current|active|decided|approved|binding|authoritative|governing|in\\s+effect|effective)|overturns?|supersedes?|replaces?|replaced|overrides?|governs|prevails?)\\b",
          "\\b(?:superseded|retired|old)\\s+(?:decision|version)\\b.{0,30}\\b(?:is\\s+)?(?:current|active|stands|applies|binding|effective)\\b"
        ],
        "decision_guard": {
          "expected_active_decision_id": "dec-contoso-api-gateway",
          "active_decision": ["dec-contoso-api-gateway", "managed edge gateway"],
          "non_binding_sources": ["raw-2026-10-12-gateway-proposal", "gateway-proposal", "mesh", "proposal"],
          "retired_refs": ["dec-contoso-api-gateway-v1", "v1", "superseded decision", "retired decision", "superseded version", "retired version", "old version"]
        }
      },
      "reference_trajectory": {
        "calls": [
          {
            "tool": "dossier",
            "returned_ids": ["dec-contoso-api-gateway", "raw-2026-10-12-gateway-proposal"],
            "status": "ok"
          },
          {
            "tool": "get",
            "returned_ids": ["dec-contoso-api-gateway"],
            "status": "ok"
          }
        ],
        "answer": "Current decision (dec-contoso-api-gateway): Contoso uses the managed edge gateway. Tension: newer source raw-2026-10-12-gateway-proposal post-dates the decision with a mesh proposal; reporting the tension without promoting the proposal over the decision layer."
      }
    },
